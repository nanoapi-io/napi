{
  "language": "c-sharp",
  "project": {
    "include": ["**/*"],
    "exclude": ["bin/**", "obj/**", "napi-output/**"]
  },
  "outDir": "napi-output",
  "audit": {
    "file": { "maxCodeChar": 5000, "maxCodeLine": 300, "maxDependency": 20, "maxCyclomaticComplexity": 50 },
    "symbol": { "maxCodeChar": 1000, "maxCodeLine": 80, "maxDependency": 10, "maxCyclomaticComplexity": 15 }
  }
}
